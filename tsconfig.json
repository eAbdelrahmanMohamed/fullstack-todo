{
  "compilerOptions": {
    "target": "es5",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "baseUrl": "./src", 
    "paths": {
      "@redux/*": ["redux/*"],
      "@main/*": ["main/*"],
      "@pages/*": ["pages/*"]
    },
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["./src/**/*"]
}
